# Copy to backend/.env and fill in real values. Never commit .env.

# --- Runtime ---------------------------------------------------------------
# development | production. Production refuses to boot with an insecure cookie
# configuration or a weak JWT secret.
APP_ENV=development

# --- Database (local PostgreSQL 18 with pgvector) --------------------------
user=postgres
password=change-me
host=127.0.0.1
port=5432
dbname=stillroom
# disable for local Postgres; require for hosted providers.
DATABASE_SSL=disable

# --- Auth ------------------------------------------------------------------
# Must be at least 32 characters; the app refuses to start otherwise.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20160
# true in production (HTTPS only).
COOKIE_SECURE=false
# Browser origin(s) allowed to call cookie-authenticated endpoints.
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI provider -----------------------------------------------------------
# Per-user provider settings live in the database (Settings -> AI). These are
# server defaults used when a user has not configured a key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=90
STORY_BIBLE_TIMEOUT_SECONDS=180
AI_MAX_CONCURRENT_REQUESTS=3

# --- Embeddings ------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
# Fixed until a deliberate re-embedding migration.
EMBEDDING_DIMENSIONS=768

# --- Limits and storage ----------------------------------------------------
# Soft warning shown on long stories; it never blocks a chapter.
STORY_CHAPTER_WARNING=1000
# Empty means any public provider host. Comma-separated hostnames restrict it.
PROVIDER_HOST_ALLOWLIST=

# --- Email -----------------------------------------------------------------
# Leave SMTP_HOST empty in local mode: password-reset links go to the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=stillroom@localhost
SMTP_STARTTLS=true

# --- Operations ------------------------------------------------------------
# SQL slower than this is logged at WARNING (the request id is included).
SLOW_QUERY_MS=500
# Relative paths resolve from the repository root; /diagnostics reads this.
BACKUP_DIR=backups

# --- Secrets ---------------------------------------------------------------
# At least 32 characters when set. Used to encrypt per-user API keys at rest.
AI_SETTINGS_ENCRYPTION_KEY=
