# Copy to .env at the repository root for docker compose. Never commit .env.

# --- Required ---------------------------------------------------------------
# At least 32 random characters: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
POSTGRES_PASSWORD=
# URL and hostname people type in the browser. Caddy needs the host only.
PUBLIC_URL=https://stillroom.localhost
PUBLIC_HOST=stillroom.localhost

# --- Optional ---------------------------------------------------------------
POSTGRES_DB=stillroom
POSTGRES_USER=stillroom
WEB_PORT=3000

# Ollama on the host. On Linux with a non-Docker Ollama, set this to the
# host gateway or run Ollama with OLLAMA_HOST=0.0.0.0:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Password-reset email. Leave SMTP_HOST empty to print reset links to the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=stillroom@localhost
SMTP_STARTTLS=true

# Encrypts per-user provider keys at rest. At least 32 characters when set.
AI_SETTINGS_ENCRYPTION_KEY=
SLOW_QUERY_MS=500